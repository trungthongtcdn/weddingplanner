# Cơ sở dữ liệu: để trống dùng SQLite cục bộ (./data/tram-nam.db).
# Khi deploy lên Vercel, dùng Turso (libSQL): libsql://<ten-db>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Bắt buộc khi chạy production: chuỗi ngẫu nhiên dài, dùng để băm mã OTP.
SESSION_SECRET=

# Địa chỉ công khai của ứng dụng, dùng để tạo link thiệp và link mời (ví dụ https://tramnam.vn)
APP_URL=

# Gửi mã OTP: ứng dụng POST {phone, code, message} tới địa chỉ này
# (dịch vụ SMS/ZNS của bạn, hoặc một luồng Zapier/n8n).
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Chỉ dùng khi thử nghiệm nội bộ: hiện mã OTP ngay trên màn hình đăng nhập.
OTP_DEV_SHOW=

# Trợ lý AI (tuỳ chọn): chỉnh lời bài phát biểu. Không có khoá thì dùng bản mẫu.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
